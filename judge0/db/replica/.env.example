# Copie este arquivo para .env e preencha fora do Git.
# Gere a senha com: openssl rand -hex 32
POSTGRES_REPLICATION_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET

# CIDR dos Pods Kubernetes que podem iniciar a conexão de replicação.
# Confirme o Pod CIDR do cluster antes da implantação.
POSTGRES_REPLICATION_CIDR=10.244.0.0/16
